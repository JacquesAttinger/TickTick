#!/usr/bin/env bash
# Last edited: 2026-09-22 12:37 PT
# Blocks a commit when a staged Swift file fails SwiftFormat (lint mode) or SwiftLint.
# It checks the working-tree content of the staged paths, not the staged blobs.
set -euo pipefail

files=()
while IFS= read -r file; do
  files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.swift')

if [[ ${#files[@]} -eq 0 ]]; then
  exit 0
fi

for tool in swiftformat swiftlint; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "pre-commit: $tool is not installed. Run scripts/setup.sh." >&2
    exit 1
  fi
done

# SwiftLint loads SourceKit from Xcode.app; the CommandLineTools path crashes it.
developer_dir="${DEVELOPER_DIR:-$(xcode-select -p)}"
if [[ "$developer_dir" != *Xcode*.app* ]]; then
  echo "pre-commit: the developer directory is $developer_dir, but SwiftLint needs Xcode." >&2
  echo "Run: sudo xcode-select -s /Applications/Xcode.app/Contents/Developer" >&2
  exit 1
fi

status=0
# Paths go before --lint: SwiftFormat can misread the first path after --lint as its value.
swiftformat "${files[@]}" --lint || status=1
swiftlint lint --strict --quiet "${files[@]}" || status=1

if [[ $status -ne 0 ]]; then
  echo "pre-commit: fix the issues above (make format fixes most formatting issues)." >&2
fi
exit $status
